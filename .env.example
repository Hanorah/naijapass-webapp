# ═══════════════════════════════════════════════════════════
# NaijaPass frontend — copy to .env.local
# ═══════════════════════════════════════════════════════════

# Express API (MySQL + Redis) — required
NEXT_PUBLIC_API_URL=http://localhost:4000

# Absolute URL of this Next.js app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: civic assistant (also configurable on the API)
GOOGLE_AI_API_KEY=

# Optional: maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
