# ═══════════════════════════════════════════════════════════
# NaijaPass frontend — copy to .env.local
# ═══════════════════════════════════════════════════════════

# Express API (required)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Google Maps (StateMap + /api/geocode)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# Optional: Resend (only if something still calls src/lib/email.ts from Next)
# Prefer putting Resend on the API (.env) for transactional mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=NaijaPass <onboarding@resend.dev>

# Optional: leftover Next KYC route (prefer API KYC)
KYC_API_KEY=
KYC_PROVIDER_URL=

# Note: Gemini for CivicChat lives on the API → naijapass-api/.env GOOGLE_AI_API_KEY
