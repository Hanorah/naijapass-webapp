# ═══════════════════════════════════════════════════════════
# NaijaPass environment
# Copy to .env.local and fill in. SETUP.md has click-by-click
# instructions for obtaining each of these.
# ═══════════════════════════════════════════════════════════

# ── Required: database, auth, realtime ─────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses row level security — never expose to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Required: absolute URL of this deployment ──────────────
# http://localhost:3000 in development, https://yourdomain.com in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: civic assistant ──────────────────────────────
# Google AI Studio → Get API key. Without it the chat falls back to the
# built-in retrieval answers instead of failing.
GOOGLE_AI_API_KEY=

# ── Optional: maps and reverse geocoding ───────────────────
# Google Cloud Console → APIs & Services → Credentials.
# Enable "Maps JavaScript API" and "Geocoding API".
# The browser key must be HTTP-referrer restricted; the server key must not.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Optional: live NIN / BVN / CAC verification ────────────
# Sandbox key from your KYC provider (see RESEARCH.md section D).
# Left blank, /api/kyc/verify runs in format-validation mode so signup works.
KYC_API_KEY=
KYC_PROVIDER_URL=
